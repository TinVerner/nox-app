// Mafia CRIME — актуальная схема PostgreSQL (nox-app)
// 12 таблиц. Убраны: сезоны, мероприятия, каталог, ранги, санкции, турниры.
// Рейтинг глобальный (без сезонного разреза). Форматы игровых вечеров: CLASSIC и NOVICE.
// Числовые правила очков настраиваются в point_rules.

Table users {
  id int [pk, increment]
  email varchar(255) [not null, unique]
  password_hash text [not null]
  display_name varchar(100) [not null]
  phone varchar(30)
  role varchar(20) [not null, default: 'PLAYER', note: 'PLAYER, HOST, ADMIN']
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE, BLOCKED']
  avatar_path text
  bonus_balance decimal(10,2) [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Note: "Одна учетная запись имеет одну роль. Гость просматривает публичные разделы без регистрации. Текущий бонусный баланс хранится в профиле."
}

Table sessions {
  id varchar(128) [pk]
  user_id int [not null]
  expires_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    user_id
    expires_at
  }

  Note: "Серверные сессии авторизации; идентификатор передается через HttpOnly cookie."
}

Table game_nights {
  id int [pk, increment]
  host_id int [not null]
  format varchar(100) [not null, note: 'CLASSIC или NOVICE']
  title varchar(200) [not null]
  description text
  starts_at timestamp [not null]
  ends_at timestamp
  registration_deadline_at timestamp
  capacity int [not null]
  status varchar(20) [not null, default: 'PLANNED', note: 'PLANNED, OPEN, CLOSED, CANCELLED']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    starts_at
    (status, starts_at)
    host_id
  }

  Note: "Игровые вечера клуба. Формат хранится непосредственно в записи игрового вечера (CLASSIC / NOVICE)."
}

Table bookings {
  id int [pk, increment]
  game_night_id int [not null]
  user_id int [not null]
  status varchar(20) [not null, default: 'CONFIRMED']
  host_notified_at timestamp
  cancellation_reason text
  cancelled_at timestamp
  over_capacity_override boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    (game_night_id, user_id) [unique]
    (game_night_id, status)
    (user_id, status)
  }

  Note: "Бронирования игроков. Превышение вместимости ведущий разрешает вручную; правила отмены проверяет сервер."
}

Table booking_guests {
  id int [pk, increment]
  booking_id int [not null]
  display_name varchar(100) [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    booking_id
  }

  Note: "Имена дополнительных гостей, которых игрок записывает вместе с собой."
}

Table parties {
  id int [pk, increment]
  game_night_id int [not null]
  party_number int [not null]
  status varchar(20) [not null, default: 'DRAFT', note: 'DRAFT, FINALIZED']
  winning_side varchar(20) [note: 'RED, BLACK и т.п.']
  created_by int [not null]
  created_at timestamp [not null, default: `now()`]
  finalized_at timestamp

  indexes {
    (game_night_id, party_number) [unique]
  }

  Note: "Отдельные партии в рамках игрового вечера. После фиксации результаты идут в глобальный рейтинг."
}

Table point_rules {
  id int [pk, increment]
  format varchar(100) [not null, note: 'CLASSIC или NOVICE']
  player_role varchar(50) [not null]
  game_result varchar(30) [not null]
  points decimal(8,2) [not null]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (format, player_role, game_result) [unique]
  }

  Note: "Правила базовых игровых очков по формату, роли и исходу партии. Значения настраиваются отдельно."
}

Table party_players {
  id int [pk, increment]
  party_id int [not null]
  user_id int
  booking_guest_id int
  player_name varchar(100) [not null]
  player_role varchar(50) [not null]
  game_result varchar(30) [not null]
  base_points decimal(8,2) [not null, default: 0]
  extra_points decimal(8,2) [not null, default: 0]
  penalty_points decimal(8,2) [not null, default: 0]
  attendance_status varchar(20) [not null, default: 'PRESENT']
  note text
  created_at timestamp [not null, default: `now()`]

  indexes {
    party_id
    user_id
    booking_guest_id
  }

  Note: "Результаты игроков в партиях. Система рассчитывает базовые очки, ведущий указывает дополнительные очки и штрафы. Рейтинг клуба строится по всем опубликованным партиям без сезонов."
}

Table news_posts {
  id int [pk, increment]
  author_id int [not null]
  title varchar(250) [not null]
  content text [not null]
  status varchar(20) [not null, default: 'PUBLISHED']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    (status, created_at)
  }

  Note: "Новостные записи клуба."
}

Table comments {
  id int [pk, increment]
  post_id int [not null]
  user_id int [not null]
  content text [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (post_id, created_at)
  }

  Note: "Комментарии к новостным записям."
}

Table reactions {
  id int [pk, increment]
  post_id int [not null]
  user_id int [not null]
  reaction_type varchar(20) [not null, default: 'LIKE']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (post_id, user_id) [unique]
  }

  Note: "Реакции пользователей на новости (по одной реакции на пост от пользователя)."
}

Table notifications {
  id int [pk, increment]
  user_id int [not null]
  notification_type varchar(50) [not null]
  message text [not null]
  target_path text
  is_read boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, is_read, created_at)
  }

  Note: "Уведомления пользователя внутри приложения."
}

// Авторизация
Ref: sessions.user_id > users.id [delete: cascade]

// Игровые вечера и бронирования
Ref: game_nights.host_id > users.id
Ref: bookings.game_night_id > game_nights.id
Ref: bookings.user_id > users.id
Ref: booking_guests.booking_id > bookings.id [delete: cascade]

// Партии и игровые результаты
Ref: parties.game_night_id > game_nights.id
Ref: parties.created_by > users.id
Ref: party_players.party_id > parties.id [delete: cascade]
Ref: party_players.user_id > users.id
Ref: party_players.booking_guest_id > booking_guests.id [delete: set null]

// Новости, комментарии и реакции
Ref: news_posts.author_id > users.id
Ref: comments.post_id > news_posts.id [delete: cascade]
Ref: comments.user_id > users.id
Ref: reactions.post_id > news_posts.id [delete: cascade]
Ref: reactions.user_id > users.id [delete: cascade]

// Уведомления
Ref: notifications.user_id > users.id [delete: cascade]
