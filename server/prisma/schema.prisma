generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name") @db.VarChar(100)
  phone        String?  @db.VarChar(30)
  role         String   @default("PLAYER") @db.VarChar(20)
  status       String   @default("ACTIVE") @db.VarChar(20)
  avatarPath   String?  @map("avatar_path")
  bonusBalance Decimal  @default(0) @map("bonus_balance") @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions          Session[]
  hostedNights      GameNight[]    @relation("NightHost")
  bookings          Booking[]
  createdParties    Party[]        @relation("PartyCreator")
  partyPlayers      PartyPlayer[]
  newsPosts         NewsPost[]
  comments          Comment[]
  reactions         Reaction[]
  notifications     Notification[]

  @@map("users")
}

model Session {
  id        String   @id @db.VarChar(128)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model GameNight {
  id                     Int       @id @default(autoincrement())
  hostId                 Int       @map("host_id")
  format                 String    @db.VarChar(100)
  title                  String    @db.VarChar(200)
  description            String?
  startsAt               DateTime  @map("starts_at")
  endsAt                 DateTime? @map("ends_at")
  registrationDeadlineAt DateTime? @map("registration_deadline_at")
  capacity               Int
  status                 String    @default("PLANNED") @db.VarChar(20)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  host                   User      @relation("NightHost", fields: [hostId], references: [id])
  bookings               Booking[]
  parties                Party[]

  @@index([startsAt])
  @@index([status, startsAt])
  @@index([hostId])
  @@map("game_nights")
}

model Booking {
  id                   Int       @id @default(autoincrement())
  gameNightId          Int       @map("game_night_id")
  userId               Int       @map("user_id")
  status               String    @default("CONFIRMED") @db.VarChar(20)
  hostNotifiedAt       DateTime? @map("host_notified_at")
  cancellationReason   String?   @map("cancellation_reason")
  cancelledAt          DateTime? @map("cancelled_at")
  overCapacityOverride Boolean   @default(false) @map("over_capacity_override")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  night                GameNight @relation(fields: [gameNightId], references: [id])
  user                 User      @relation(fields: [userId], references: [id])
  guests               BookingGuest[]

  @@unique([gameNightId, userId])
  @@index([gameNightId, status])
  @@index([userId, status])
  @@map("bookings")
}

model BookingGuest {
  id          Int      @id @default(autoincrement())
  bookingId   Int      @map("booking_id")
  displayName String   @map("display_name") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  partyPlayers  PartyPlayer[]

  @@index([bookingId])
  @@map("booking_guests")
}

model Party {
  id          Int       @id @default(autoincrement())
  gameNightId Int       @map("game_night_id")
  partyNumber Int       @map("party_number")
  status      String    @default("DRAFT") @db.VarChar(20)
  winningSide String?   @map("winning_side") @db.VarChar(20)
  createdBy   Int       @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  finalizedAt DateTime? @map("finalized_at")
  night       GameNight @relation(fields: [gameNightId], references: [id])
  creator     User      @relation("PartyCreator", fields: [createdBy], references: [id])
  players     PartyPlayer[]

  @@unique([gameNightId, partyNumber])
  @@map("parties")
}

model PointRule {
  id          Int      @id @default(autoincrement())
  format      String   @db.VarChar(100)
  playerRole  String   @map("player_role") @db.VarChar(50)
  gameResult  String   @map("game_result") @db.VarChar(30)
  points      Decimal  @db.Decimal(8, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([format, playerRole, gameResult])
  @@map("point_rules")
}

model PartyPlayer {
  id               Int      @id @default(autoincrement())
  partyId          Int      @map("party_id")
  userId           Int?     @map("user_id")
  bookingGuestId   Int?     @map("booking_guest_id")
  playerName       String   @map("player_name") @db.VarChar(100)
  playerRole       String   @map("player_role") @db.VarChar(50)
  gameResult       String   @map("game_result") @db.VarChar(30)
  basePoints       Decimal  @default(0) @map("base_points") @db.Decimal(8, 2)
  extraPoints      Decimal  @default(0) @map("extra_points") @db.Decimal(8, 2)
  penaltyPoints    Decimal  @default(0) @map("penalty_points") @db.Decimal(8, 2)
  attendanceStatus String   @default("PRESENT") @map("attendance_status") @db.VarChar(20)
  note             String?
  createdAt        DateTime @default(now()) @map("created_at")
  party            Party         @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user             User?         @relation(fields: [userId], references: [id])
  guest            BookingGuest? @relation(fields: [bookingGuestId], references: [id], onDelete: SetNull)

  @@index([partyId])
  @@index([userId])
  @@index([bookingGuestId])
  @@map("party_players")
}

model NewsPost {
  id        Int      @id @default(autoincrement())
  authorId  Int      @map("author_id")
  title     String   @db.VarChar(250)
  content   String
  status    String   @default("PUBLISHED") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  author    User     @relation(fields: [authorId], references: [id])
  comments  Comment[]
  reactions Reaction[]

  @@index([status, createdAt])
  @@map("news_posts")
}

model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  post      NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([postId, createdAt])
  @@map("comments")
}

model Reaction {
  id           Int      @id @default(autoincrement())
  postId       Int      @map("post_id")
  userId       Int      @map("user_id")
  reactionType String   @default("LIKE") @map("reaction_type") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")
  post         NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("reactions")
}

model Notification {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  notificationType String   @map("notification_type") @db.VarChar(50)
  message          String
  targetPath       String?  @map("target_path")
  isRead           Boolean  @default(false) @map("is_read")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}
