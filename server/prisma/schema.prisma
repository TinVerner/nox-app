generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nick      String
  role      String   @default("PLAYER")
  blocked   Boolean  @default(false)
  rank      String?
  bonus     Int      @default(0)
  createdAt DateTime @default(now())
  comments  Comment[]
  reactions Reaction[]
  sanctions Sanction[]
}

model ClubSettings {
  id           String  @id @default(cuid())
  name         String  @default("NOX")
  bookingOpen  Boolean @default(true)
  waitlistSize Int     @default(4)
}

model News {
  id        String    @id @default(cuid())
  title     String
  body      String
  createdAt DateTime  @default(now())
  comments  Comment[]
  reactions Reaction[]
}

model Comment {
  id        String   @id @default(cuid())
  newsId    String
  news      News     @relation(fields: [newsId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model Season {
  id     String  @id @default(cuid())
  name   String
  closed Boolean @default(false)
  games  Game[]
}

model Game {
  id       String   @id @default(cuid())
  title    String
  startsAt DateTime
  place    String
  seats    Int
  status   String   @default("PUBLISHED")
  kind     String   @default("CLASSIC")
  price    Int      @default(0)
  seasonId String?
  season   Season?  @relation(fields: [seasonId], references: [id])
  results  Result[]
}

model Result {
  id        String   @id @default(cuid())
  gameId    String
  nick      String
  points    Int
  createdAt DateTime @default(now())
  game      Game     @relation(fields: [gameId], references: [id])
}

model Booking {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  status    String   @default("CONFIRMED")
  createdAt DateTime @default(now())
  guests    BookingGuest[]

  @@unique([userId, gameId])
}

model BookingGuest {
  id          String   @id @default(cuid())
  bookingId   String
  displayName String
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Reaction {
  id        String   @id @default(cuid())
  newsId    String
  userId    String
  createdAt DateTime @default(now())
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsId, userId])
}

model Sanction {
  id         String   @id @default(cuid())
  userId     String
  kind       String
  reason     String
  bonusDelta Int      @default(0)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model CatalogItem {
  id     String @id @default(cuid())
  name   String
  detail String @default("")
  price  Int
}

model PlayerStat {
  id     String @id @default(cuid())
  nick   String
  points Int
  games  Int
}